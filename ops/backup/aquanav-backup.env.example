# Install at /etc/aquanav-backup.env, mode 600, owned by root.
# Parsed literally: no quotes, no spaces around "=". A password may contain
# spaces or punctuation - put it in as-is.
FTP_HOST=
FTP_USER=
FTP_PASS=
# age PUBLIC key only (age1...). The matching PRIVATE key must live in a
# password manager, never on the server - it is the only way to read a backup.
AGE_RECIPIENT=
